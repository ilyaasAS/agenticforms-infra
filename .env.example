# --- Configuration Globale AgenticForm ---
# Copier ce fichier vers .env et remplacer les valeurs changeme_* avant utilisation.
# Ne jamais committer .env (secrets). Docker Compose charge ce fichier via env_file.

# Ports (bindés sur 127.0.0.1 dans docker-compose.yml)
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Profil Spring — prod par défaut dans Compose (durcissement)
SPRING_PROFILES_ACTIVE=prod
# Cookies Secure : false en HTTP local ; true dès qu'un TLS termine devant l'API
COOKIE_FORCE_SECURE=false

# Frontend build args (OAuth redirect origin)
VITE_BACKEND_URL=http://localhost:8080
VITE_API_BASE_URL=/api

# Base de données (MySQL)
DB_HOST=db
DB_PORT=3306
DB_NAME=agenticform
DB_USER=changeme_db_user
DB_PASSWORD=changeme_db_password
DB_ROOT_PASSWORD=changeme_db_root_password

# Sécurité JWT — min. 32 caractères (256 bits HMAC)
JWT_SECRET=changeme_jwt_secret_min_32_chars_xxxxxxxx
JWT_EXPIRATION=3600000

# Origines frontend autorisées (CORS) — jamais *
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth2 (Google / Microsoft Entra ID) — laisser vide pour désactiver
# Redirect Google : http://localhost:8080/login/oauth2/code/google
# Redirect Azure  : http://localhost:8080/login/oauth2/code/azure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# SMTP (dev) — Mailpit via Docker Compose (UI : http://localhost:8025)
# SPRING_MAIL_HOST=mailpit sous Docker ; localhost si le backend tourne hors Compose.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
# Username SMTP (auth) — laisser vide pour Mailpit. NE PAS y mettre l'adresse From.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Adresse From des e-mails (vérification / reset) — obligatoire, non vide
MAIL_FROM=no-reply@agenticforms.com
RESET_PASSWORD_URL=http://localhost:5173/reset-password
VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# --- MongoDB (NoSQL) ---
MONGO_INITDB_ROOT_USERNAME=changeme_mongo_user
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_DATABASE=agenticform_nosql
MONGO_URI=mongodb://changeme_mongo_user:changeme_mongo_password@mongo:27017/agenticform_nosql?authSource=admin

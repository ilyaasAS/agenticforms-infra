# --- Configuration Globale AgenticForm ---
# Copier ce fichier vers .env et remplacer les valeurs changeme_* avant utilisation.
# Ne jamais committer .env (secrets). Docker Compose charge ce fichier via env_file.

# Ports (bindés sur 127.0.0.1 dans docker-compose.yml)
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Profil Spring — prod par défaut dans Compose (durcissement)
SPRING_PROFILES_ACTIVE=prod
# Cookies Secure : false en HTTP local ; true dès qu'un TLS termine devant l'API
COOKIE_FORCE_SECURE=false

# Frontend build args (OAuth redirect origin)
VITE_BACKEND_URL=http://localhost:8080
VITE_API_BASE_URL=/api
# Unsplash Access Key (Client-ID) — injectée au build Docker / Vite
VITE_UNSPLASH_ACCESS_KEY=

# Base de données (MySQL)
DB_HOST=db
DB_PORT=3306
DB_NAME=agenticform
DB_USER=changeme_db_user
DB_PASSWORD=changeme_db_password
DB_ROOT_PASSWORD=changeme_db_root_password

# Sécurité JWT — min. 32 caractères (256 bits HMAC)
JWT_SECRET=changeme_jwt_secret_min_32_chars_xxxxxxxx
JWT_EXPIRATION=3600000

# Origines frontend autorisées (CORS) — jamais *
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth2 (Google / Microsoft Entra ID) — laisser vide pour désactiver
# Redirect Google : http://localhost:8080/login/oauth2/code/google
# Redirect Azure  : http://localhost:8080/login/oauth2/code/azure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# Calendly OAuth (intégration planification — pas le login AgenticForms)
# Créer une appli sur https://developer.calendly.com
# Redirect URI à déclarer : http://localhost:5173/api/v1/integrations/calendly/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:5173/api/v1/integrations/calendly/callback

# Stripe (paiements — https://dashboard.stripe.com/apikeys)
# Sans STRIPE_CLIENT_ID : mode plateforme (charges sur le compte des clés).
# Avec STRIPE_CLIENT_ID (Connect) : OAuth « Se connecter à Stripe » + charges sur le compte connecté.
# Redirect Connect à déclarer : http://localhost:5173/api/v1/integrations/stripe/callback
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CLIENT_ID=
STRIPE_REDIRECT_URI=http://localhost:5173/api/v1/integrations/stripe/callback

# Google Calendar OAuth (planification native — distinct du login Google)
# Peut réutiliser GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET avec une redirect URI supplémentaire :
# http://localhost:5173/api/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/v1/integrations/google-calendar/callback

# Connexion Google des répondants (page Connexion — redirect URI supplémentaire dans Google Cloud)
# http://localhost:5173/api/v1/public/forms/login/google/callback
GOOGLE_FORM_LOGIN_REDIRECT_URI=http://localhost:5173/api/v1/public/forms/login/google/callback

# SMTP (dev) — Mailpit via Docker Compose (UI : http://localhost:8025)
# SPRING_MAIL_HOST=mailpit sous Docker ; localhost si le backend tourne hors Compose.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
# Username SMTP (auth) — laisser vide pour Mailpit. NE PAS y mettre l'adresse From.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Adresse From des e-mails (vérification / reset) — obligatoire, non vide
MAIL_FROM=no-reply@agenticforms.com
RESET_PASSWORD_URL=http://localhost:5173/reset-password
VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# --- MongoDB (NoSQL) ---
MONGO_INITDB_ROOT_USERNAME=changeme_mongo_user
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_DATABASE=agenticform_nosql
MONGO_URI=mongodb://changeme_mongo_user:changeme_mongo_password@mongo:27017/agenticform_nosql?authSource=admin

# Google reCAPTCHA v2 — clés de test Google OK en local ; remplacer en prod
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
